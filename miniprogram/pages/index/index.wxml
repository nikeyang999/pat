<view class="page-shell">
  <view class="header-row">
    <view>
      <view class="eyebrow">PETLY · 宠物生活管家</view>
      <view class="page-title">你好，铲屎官</view>
      <view class="page-subtitle">今天也要照顾好你的小伙伴</view>
    </view>
    <view class="notice-button" bindtap="showNotice"><text class="notice-icon">♧</text><view class="notice-dot"></view></view>
  </view>

  <block wx:if="{{activeTab === 0}}">
    <view class="pet-card" bindtap="viewPet">
      <view class="pet-card-top">
        <view class="pet-avatar-wrap"><image class="pet-avatar" src="{{currentPet.avatar}}" mode="aspectFill"></image><view class="online-dot"></view></view>
        <view class="pet-main"><view class="pet-name-row"><text class="pet-name">{{currentPet.name}}</text><text class="pet-tag">{{currentPet.type}}</text></view><view class="pet-meta">{{currentPet.age}} · {{currentPet.weight}} kg</view><view class="health-row"><text class="health-dot">●</text> 健康状态良好</view></view>
        <view class="chevron">›</view>
      </view>
      <view class="pet-stats"><view class="stat-item"><text class="stat-value">{{currentPet.daysTogether}}</text><text class="stat-label">相伴天数</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-value">{{currentPet.weight}}kg</text><text class="stat-label">最近体重</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-value">{{currentPet.nextVisit}}</text><text class="stat-label">下次体检</text></view></view>
    </view>
    <view class="section-heading"><text>今日照护</text><text class="section-link" bindtap="goRecords">查看全部 ›</text></view>
    <view class="task-list"><view class="task-item" wx:for="{{tasks}}" wx:key="id" bindtap="toggleTask" data-id="{{item.id}}"><view class="task-check {{item.done ? 'task-check-done' : ''}}"><text wx:if="{{item.done}}">✓</text></view><view class="task-copy"><text class="task-title {{item.done ? 'task-done' : ''}}">{{item.title}}</text><text class="task-time">{{item.time}}</text></view><text class="task-kind {{item.kind}}">{{item.kindLabel}}</text></view></view>
    <view class="section-heading section-heading-space"><text>快捷功能</text></view>
    <view class="quick-grid"><view class="quick-item" bindtap="quickAction" data-action="record"><view class="quick-icon quick-icon-peach">＋</view><text>记一笔</text><text class="quick-hint">饮食 · 体重</text></view><view class="quick-item" bindtap="quickAction" data-action="remind"><view class="quick-icon quick-icon-blue">◷</view><text>设置提醒</text><text class="quick-hint">疫苗 · 驱虫</text></view><view class="quick-item" bindtap="quickAction" data-action="hospital"><view class="quick-icon quick-icon-green">⌖</view><text>附近服务</text><text class="quick-hint">医院 · 美容</text></view><view class="quick-item" bindtap="quickAction" data-action="share"><view class="quick-icon quick-icon-yellow">♧</view><text>分享成长</text><text class="quick-hint">记录每个瞬间</text></view></view>
  </block>

  <block wx:if="{{activeTab === 1}}"><view class="subpage-intro"><text class="subpage-title">成长记录</text><text class="subpage-caption">把每一次变化都留存下来</text></view><view class="record-summary"><view><text class="summary-number">{{currentPet.weight}}</text><text class="summary-unit">kg</text><text class="summary-label">当前体重</text></view><view class="summary-trend">较上月 <text>{{currentPet.weightChange}}</text> <text class="trend-arrow">↗</text></view></view><view class="record-section-title">最近记录</view><view class="timeline-item" wx:for="{{records}}" wx:key="id"><view class="timeline-dot {{item.color}}"></view><view class="timeline-copy"><text class="timeline-title">{{item.title}}</text><text class="timeline-detail">{{item.detail}}</text></view><text class="timeline-date">{{item.date}}</text></view><view class="primary-button" bindtap="addRecord">＋ 添加记录</view></block>

  <block wx:if="{{activeTab === 2}}"><view class="subpage-intro"><view><text class="subpage-title">附近宠友</text><text class="subpage-caption">分享日常，也找到同频的伙伴</text></view><view class="publish-button" bindtap="addPost">＋ 发布动态</view></view><scroll-view class="topic-scroll" scroll-x="true"><view class="topic-chip topic-chip-active">推荐</view><view class="topic-chip">遛狗搭子</view><view class="topic-chip">养猫日常</view><view class="topic-chip">新手问答</view></scroll-view><view class="post-card" wx:for="{{posts}}" wx:key="id"><view class="post-author"><view class="post-avatar">{{item.avatar}}</view><view><text class="post-name">{{item.name}}</text><text class="post-time">{{item.time}}</text></view><text class="follow-btn {{item.followed ? 'followed' : ''}}" bindtap="followUser" data-id="{{item.id}}">{{item.followed ? '已关注' : '＋ 关注'}}</text></view><text class="post-text">{{item.text}}</text><view class="post-image {{item.imageTone}}"><text>{{item.imageEmoji}}</text></view><view class="post-actions"><text class="post-action {{item.liked ? 'liked' : ''}}" bindtap="likePost" data-id="{{item.id}}">{{item.liked ? '♥' : '♡'}} {{item.likes}}</text><text class="post-action" bindtap="commentPost" data-id="{{item.id}}">◌ {{item.comments}}</text><button class="share-action" open-type="share">↗ 分享</button></view></view></block>

  <block wx:if="{{activeTab === 3}}"><view class="subpage-intro"><text class="subpage-title">我的</text><text class="subpage-caption">管理你和宠物的生活信息</text></view><view class="profile-card" bindtap="menuAction" data-action="pets"><view class="profile-avatar">W</view><view class="profile-copy"><text class="profile-name">我的宠物档案</text><text class="profile-caption">{{currentPet.name}} · {{currentPet.type}}</text></view><text class="chevron">›</text></view><view class="menu-list"><view class="menu-row" bindtap="menuAction" data-action="pets"><text class="menu-icon">♡</text><text>我的宠物</text><text class="menu-value">{{petCount}} 只 ›</text></view><view class="menu-row" bindtap="menuAction" data-action="reminders"><text class="menu-icon">◷</text><text>提醒管理</text><text class="menu-value">{{reminderCount}} 项 ›</text></view><view class="menu-row" bindtap="menuAction" data-action="settings"><text class="menu-icon">⚙</text><text>偏好设置</text><text class="menu-value">›</text></view><view class="menu-row" bindtap="menuAction" data-action="data"><text class="menu-icon">▣</text><text>数据中心</text><text class="menu-value">MySQL ›</text></view></view><view class="support-box"><text class="support-title">让照顾更简单</text><text class="support-copy">给宠物建立完整档案，提醒、记录和服务都集中在这里。</text><view class="support-button" bindtap="addPet">＋ 添加宠物</view></view></block>

  <view class="tab-bar"><view class="tab-item {{activeTab === 0 ? 'tab-active' : ''}}" data-tab="0" bindtap="switchTab"><text class="tab-icon">⌂</text><text>首页</text></view><view class="tab-item {{activeTab === 1 ? 'tab-active' : ''}}" data-tab="1" bindtap="switchTab"><text class="tab-icon">▣</text><text>记录</text></view><view class="tab-item {{activeTab === 2 ? 'tab-active' : ''}}" data-tab="2" bindtap="switchTab"><text class="tab-icon">◉</text><text>社区</text></view><view class="tab-item {{activeTab === 3 ? 'tab-active' : ''}}" data-tab="3" bindtap="switchTab"><text class="tab-icon">♙</text><text>我的</text></view></view>

  <view wx:if="{{modalType}}" class="modal-mask" catchtap="closeModal"><view class="modal-panel" catchtap="stopPropagation">
    <view class="modal-header"><text class="modal-title">{{modalTitle}}</text><text class="modal-close" bindtap="closeModal">×</text></view>
    <block wx:if="{{modalType === 'record'}}"><view class="form-label">记录类型</view><view class="type-options"><view class="type-option {{recordForm.type === '体重' ? 'type-option-active' : ''}}" data-type="体重" bindtap="selectRecordType">体重</view><view class="type-option {{recordForm.type === '饮食' ? 'type-option-active' : ''}}" data-type="饮食" bindtap="selectRecordType">饮食</view><view class="type-option {{recordForm.type === '运动' ? 'type-option-active' : ''}}" data-type="运动" bindtap="selectRecordType">运动</view></view><input class="form-input" placeholder="输入记录详情，如 12.8 kg" value="{{recordForm.detail}}" bindinput="onRecordDetailInput"/><view class="modal-button" bindtap="saveRecord">保存记录</view></block>
    <block wx:if="{{modalType === 'pet'}}"><view class="form-label">宠物名称</view><input class="form-input" placeholder="例如：豆包" value="{{petForm.name}}" bindinput="onPetInput" data-field="name"/><view class="form-label">品种</view><input class="form-input" placeholder="例如：柯基犬" value="{{petForm.type}}" bindinput="onPetInput" data-field="type"/><view class="form-row"><input class="form-input form-half" placeholder="年龄" value="{{petForm.age}}" bindinput="onPetInput" data-field="age"/><input class="form-input form-half" placeholder="体重 kg" value="{{petForm.weight}}" bindinput="onPetInput" data-field="weight"/></view><view class="modal-button" bindtap="savePet">保存档案</view></block>
    <block wx:if="{{modalType === 'reminder'}}"><view class="form-label">提醒内容</view><input class="form-input" placeholder="例如：每月体外驱虫" value="{{reminderForm.title}}" bindinput="onReminderInput" data-field="title"/><view class="form-label">提醒时间</view><input class="form-input" placeholder="例如：10月18日 09:00" value="{{reminderForm.time}}" bindinput="onReminderInput" data-field="time"/><view class="modal-button" bindtap="saveReminder">创建提醒</view></block>
    <block wx:if="{{modalType === 'notice'}}"><view class="notice-list"><view class="notice-row" wx:for="{{tasks}}" wx:key="id"><view class="notice-mark {{item.done ? 'notice-mark-done' : ''}}">{{item.done ? '✓' : '!'}}</view><view><text class="notice-row-title">{{item.title}}</text><text class="notice-row-time">{{item.time}}</text></view></view></view><view class="modal-button modal-button-light" bindtap="closeModal">知道了</view></block>
    <block wx:if="{{modalType === 'service'}}"><view class="service-card" wx:for="{{services}}" wx:key="id"><view class="service-info"><text class="service-name">{{item.name}}</text><text class="service-meta">{{item.type}} · {{item.distance}}</text><text class="service-rating">★ {{item.rating}} · {{item.open}}</text></view><view class="service-call" bindtap="contactService" data-id="{{item.id}}" data-name="{{item.name}}">预约</view></view></block>
    <block wx:if="{{modalType === 'post'}}"><view class="form-label">动态内容</view><textarea class="post-textarea" maxlength="1000" placeholder="分享你和宠物的日常…" value="{{postForm.text}}" bindinput="onPostInput"></textarea><view class="modal-button" bindtap="savePost">发布动态</view></block>
    <block wx:if="{{modalType === 'settings'}}"><view class="setting-row"><text>每日照护提醒</text><switch checked="{{settings.dailyReminder}}" color="#8c9e7b" bindchange="toggleSetting" data-key="dailyReminder"/></view><view class="setting-row"><text>社区互动通知</text><switch checked="{{settings.communityNotice}}" color="#8c9e7b" bindchange="toggleSetting" data-key="communityNotice"/></view><view class="setting-row setting-danger" bindtap="clearData"><text>清除本地演示数据</text><text>›</text></view></block>
  </view></view>
</view>
