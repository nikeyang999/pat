page { background: #f8f7f4; color: #242321; padding-bottom: 150rpx; }
.page-shell { padding: 52rpx 36rpx 180rpx; box-sizing: border-box; min-height: 100vh; font-family: "PingFang SC", sans-serif; }
.header-row { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:42rpx; }.eyebrow { color:#a49e93; font-size:21rpx; letter-spacing:3rpx; margin-bottom:13rpx; }.page-title { color:#242321; font-size:48rpx; font-weight:600; line-height:1.2; }.page-subtitle { color:#8f8a82; font-size:25rpx; margin-top:12rpx; }
.notice-button { position:relative; width:76rpx; height:76rpx; border-radius:24rpx; background:#fff; display:flex; justify-content:center; align-items:center; box-shadow:0 8rpx 22rpx rgba(50,42,30,.05); }.notice-icon { color:#716b61; font-size:39rpx; transform:rotate(-25deg); }.notice-dot { position:absolute; width:13rpx; height:13rpx; background:#ee8060; border:4rpx solid #fff; border-radius:50%; top:14rpx; right:14rpx; }
